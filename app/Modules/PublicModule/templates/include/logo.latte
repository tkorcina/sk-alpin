{*
	Výchozí logo SK-Alpin: tučné „SK“ vyplněné horskou krajinou (nebe se sluncem, zasněžené štíty, les),
	pod ním prostrkané „ALPIN“. Použije se, když v Nastavení není nahrané vlastní logo.
	Inline SVG — dědí písmo Urbanist z webu.
*}
<svg class="site-logo site-logo-default" viewBox="0 0 118 74" width="102" height="64" role="img" aria-label="SK-Alpin">
	<defs>
		<linearGradient id="skSky" x1="0" y1="0" x2="0" y2="1">
			<stop offset="0" stop-color="#7fc0e4"/>
			<stop offset=".6" stop-color="#dcf0f9"/>
		</linearGradient>
		<clipPath id="skClip">
			<text x="59" y="55" text-anchor="middle" font-family="Urbanist, 'Segoe UI', Arial, sans-serif" font-weight="900" font-size="72" letter-spacing="0">SK</text>
		</clipPath>
	</defs>
	<g clip-path="url(#skClip)">
		<rect x="0" y="0" width="118" height="74" fill="url(#skSky)"/>
		<circle cx="88" cy="16" r="7" fill="#f6d77a"/>
		<path d="M-5 58 L16 26 L27 40 L42 12 L58 38 L68 28 L86 52 L98 36 L123 60 L123 74 L-5 74 Z" fill="#7d9a6a"/>
		<path d="M42 12 L47.5 21 L42 19 L36.5 21 Z M98 36 L102 42 L98 40.5 L94 42 Z M16 26 L19.5 31.5 L16 30.5 L12.5 31.5 Z" fill="#ffffff"/>
		<path d="M-5 60 L12 44 L30 56 L46 42 L62 58 L78 48 L96 62 L123 50 L123 74 L-5 74 Z" fill="#3f7a52"/>
		<path d="M-5 66 L10 58 L26 66 L44 58 L60 68 L76 60 L92 68 L110 62 L123 66 L123 74 L-5 74 Z" fill="#2c5e3f"/>
	</g>
	<text x="59" y="55" text-anchor="middle" font-family="Urbanist, 'Segoe UI', Arial, sans-serif" font-weight="900" font-size="72" letter-spacing="0" fill="none" stroke="#1e4a30" stroke-width="1.5">SK</text>
	<text x="59" y="71" text-anchor="middle" font-family="Urbanist, 'Segoe UI', Arial, sans-serif" font-weight="700" font-size="13.5" letter-spacing="7" fill="#7a5a3a">ALPIN</text>
</svg>
