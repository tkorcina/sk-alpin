{*
	Výchozí logo: nápis „SK-ALPIN“ vyplněný zimní horskou krajinou — nebe se sluncem, zasněžené štíty,
	sjezdovka s lyžařskými stopami, les dole. Použije se, když v Nastavení není nahrané vlastní logo.
	Inline SVG — dědí písmo Urbanist z webu.
*}
<svg class="site-logo site-logo-default" viewBox="45.6 9 229 43" width="341" height="64" role="img" aria-label="SK-Alpin">
	<defs>
		<linearGradient id="skSky" x1="0" y1="0" x2="0" y2="1">
			<stop offset="0" stop-color="#4fa3d8"/>
			<stop offset="1" stop-color="#cfe8f6"/>
		</linearGradient>
		<clipPath id="skClip">
			<text x="160" y="50" text-anchor="middle" font-family="Urbanist, 'Segoe UI', Arial, sans-serif" font-weight="900" font-size="54" letter-spacing="-1">SK-ALPIN</text>
		</clipPath>
	</defs>
	<g clip-path="url(#skClip)">
		{* nebe + slunce *}
		<rect x="0" y="0" width="320" height="56" fill="url(#skSky)"/>
		<circle cx="248" cy="18" r="8" fill="#f9d566"/>
		{* zasněžené štíty *}
		<path d="M-5 40 L20 18 L36 30 L58 12 L80 32 L100 22 L124 36 L150 14 L172 34 L196 24 L218 38 L246 16 L270 34 L294 22 L325 36 L325 56 L-5 56 Z" fill="#5f7f99"/>
		<path d="M58 12 L64.5 19 L58 17 L51.5 19 Z M150 14 L156 21 L150 19 L144 21 Z M246 16 L252 23 L246 21 L240 23 Z M20 18 L25 23.5 L20 22 L15 23.5 Z M294 22 L298.5 27 L294 25.5 L289.5 27 Z" fill="#ffffff"/>
		{* sjezdovka — bílý svah se stopami lyží *}
		<path d="M-5 40 L40 30 L90 42 L150 30 L210 44 L260 32 L325 42 L325 56 L-5 56 Z" fill="#ffffff"/>
		<path d="M30 36 C70 33, 100 44, 140 40 S200 37, 230 46 S285 39, 320 44" fill="none" stroke="#9fbfd4" stroke-width="1.5" stroke-linecap="round"/>
		<path d="M30 39.5 C70 36.5, 100 47.5, 140 43.5 S200 40.5, 230 49.5 S285 42.5, 320 47.5" fill="none" stroke="#9fbfd4" stroke-width="1.5" stroke-linecap="round"/>
		{* les *}
		<path d="M-5 48 L6 42 L16 48 L26 41 L36 48 L46 42 L56 48 L68 40 L80 48 L92 42 L102 48 L116 41 L128 48 L140 43 L152 48 L166 41 L178 48 L190 42 L200 48 L214 41 L226 48 L238 43 L250 48 L264 41 L276 48 L288 43 L300 48 L312 42 L325 48 L325 56 L-5 56 Z" fill="#3f7a52"/>
		<path d="M-5 52 L12 48 L26 52 L42 47 L58 52 L74 48 L90 52 L106 47 L122 52 L138 48 L154 52 L170 47 L186 52 L202 48 L218 52 L234 47 L250 52 L266 48 L282 52 L298 47 L325 52 L325 56 L-5 56 Z" fill="#2c5e3f"/>
	</g>
	{* obrys písma *}
	<text x="160" y="50" text-anchor="middle" font-family="Urbanist, 'Segoe UI', Arial, sans-serif" font-weight="900" font-size="54" letter-spacing="-1" fill="none" stroke="#1e4a30" stroke-width="1.4" stroke-linejoin="round">SK-ALPIN</text>
</svg>
