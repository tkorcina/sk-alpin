<!DOCTYPE html>
<html lang="{$locale}">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="robots" content="index, follow">
	<meta name="author" content="Tomáš Korcina aka Korca">
	<meta name="description" content="{$metaDescription}">
	<link rel="canonical" href="{$canonicalUrl}">

	<title>{ifset $pageTitle}{$pageTitle} | {/ifset}{$settings->getSiteTitle()}</title>

	{* Open Graph / sdílení odkazu *}
	<meta property="og:type" content="website">
	<meta property="og:locale" content="cs_CZ">
	<meta property="og:site_name" content="{$settings->getSiteTitle()}">
	<meta property="og:title" content="{ifset $pageTitle}{$pageTitle} | {/ifset}{$settings->getSiteTitle()}">
	<meta property="og:description" content="{$metaDescription}">
	<meta property="og:url" content="{$canonicalUrl}">
	<meta property="og:image" n:if="$ogImage" content="{$ogImage}">
	<meta name="twitter:card" content="{$ogImage ? 'summary_large_image' : 'summary'}">

	{* Favicony (generované z loga — www/images/favicons) *}
	<link rel="icon" href="{$basePath}/favicon.ico" sizes="32x32">
	<link rel="icon" href="{$basePath}/images/favicons/favicon.svg" type="image/svg+xml">
	<link rel="apple-touch-icon" href="{$basePath}/images/favicons/apple-touch-icon.png">
	<link rel="manifest" href="{$basePath}/images/favicons/site.webmanifest">
	<meta name="theme-color" content="#2c5e3f">

	<link rel="preload" href="{$basePath}/dist/fonts/Raleway-Variable.woff2" as="font" type="font/woff2" crossorigin>

	<link rel="stylesheet" href="{$basePath}/dist/css/app.css">

	<script src="{$basePath}/dist/js/app.js?v={mt_rand(100,999)}"></script>
</head>

<body>
	<header class="site-header">
		<div class="container py-3">
			<div class="d-md-flex justify-content-between align-items-center">
				<div class="d-flex justify-content-between align-items-center">
					<a n:href="Homepage:default" class="site-brand me-4" title="{$settings->getSiteTitle()}">
						{if $settings->getLogo()}
							<img class="site-logo" src="{$basePath}{$settings->getLogo()->getPath()}" alt="{$settings->getSiteTitle()}">
						{else}
							{include 'include/logo.latte'}
						{/if}
 					</a>
					<button class="nav-toggle d-md-none" type="button" data-bs-toggle="collapse" data-bs-target="#siteNav" aria-controls="siteNav" aria-expanded="false" aria-label="Otevřít menu">
						<span class="nav-toggle-bar"></span>
						<span class="nav-toggle-bar"></span>
						<span class="nav-toggle-bar"></span>
					</button>
				</div>
				<nav class="site-nav collapse d-md-flex" id="siteNav">
					<a n:href="Homepage:default" n:class="$presenter->isLinkCurrent('Homepage:*') ? active">Úvod</a>
					<a n:href="Page:default internalName => about" n:class="$presenter->isLinkCurrent('Page:*') ? active">O nás</a>
					<a n:href="Event:default" n:class="$presenter->isLinkCurrent('Event:*') ? active">Akce</a>
					<a n:href="Gallery:default" n:class="$presenter->isLinkCurrent('Gallery:*') ? active">Fotogalerie</a>
					<a n:href="News:default" n:class="$presenter->isLinkCurrent('News:*') ? active">Aktuality</a>
					<a n:href="Contact:default" n:class="$presenter->isLinkCurrent('Contact:*') ? active">Kontakt</a>
				</nav>
			</div>
		</div>
	</header>

	<main>

		{snippet flashes}
			<div n:foreach="$flashes as $flash" n:class="alert, show, my-0, rounded-0,
					$flash->type === 'success' ? 'alert-success',
					$flash->type === 'danger' ? 'alert-danger',
					$flash->type === 'warning' ? 'alert-warning',
					$flash->type === 'info' ? 'alert-info',
				"
				role="alert"
			>
				<div class="media d-flex align-items-center">
					<div class="d-flex g-mr-10">
						<i n:class="
							$flash->type === 'success' ? 'icon-check',
							$flash->type === 'danger' ? 'icon-ban',
							$flash->type === 'warning' ? 'icon-info',
							$flash->type === 'info' ? 'icon-question',
							g-font-size-25
						"></i>
					</div>
					<div class="media-body align-self-center">{_$flash->message|noescape}</div>
				</div>
			</div>
		{/snippet}

		{include content}

		<footer class="site-footer">
			<div class="container">
				<div class="row">
					<div class="col-md-6">
						<strong>{$settings->getCompanyName()}</strong><br>
						{if $settings->getCompanyAddress()}{$settings->getCompanyAddress()}<br>{/if}
						{if $settings->getCompanyIco()}IČO: {$settings->getCompanyIco()}{/if}
					</div>
					<div class="col-md-6 text-md-end mt-3 mt-md-0">
						<a n:href="Contact:default">Kontakt</a><br>
						<small>© {Nette\Utils\DateTime::from('now')|date:'Y'} sk-alpin.cz</small>
					</div>
				</div>
			</div>
		</footer>
	</main>

	{include 'include/cookieBar.latte'}

	{block scripts}
		{ifset componentJs}{include componentJs}{/ifset}
	{/block}

	{include 'include/js.latte'}

	{block js}{/block}

	<script type="text/javascript">
		function addMetaTag(name,content){
			var meta = document.createElement('meta');
			meta.httpEquiv = name;
			meta.content = content;
		}

		{if $validateCache}
			addMetaTag("pragma","no-cache");
			addMetaTag("expires","0");
			addMetaTag("cache-control","no-cache");
			Cookies.set('cacheDeleted', '1', { expires: 1 }); // budem mazat cache každý den
			location.reload();
		{/if}
	</script>

	<script src="{$basePath}/assets/js/nette.ajax.js"></script>
</body>
</html>
