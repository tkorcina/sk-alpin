{block content}

<section class="section">
	<div class="container">
		<h1>Aktuality</h1>

		<p n:if="!$newsList">Zatím tu nejsou žádné aktuality.</p>

		<div class="item-list">
			<article n:foreach="$newsList as $news" class="item-row">
				<span class="date-badge">{$news->getPublishedAt()|date:'j. n. Y'}</span>
				<h3><a n:href="detail slug => $news->getSlug()">{$news->getTitle()}</a></h3>
			</article>
		</div>

		{control paginator}
	</div>
</section>
