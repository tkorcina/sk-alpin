{block content}

<section class="section">
	<div class="container">
		<h1>{$gallery->getTitle()}</h1>
		<p>
			<span class="date-badge" n:if="$gallery->getDate()">{$gallery->getDate()|date:'j. n. Y'}</span>
			<span n:if="$gallery->getEvent()" class="ms-2">
				Fotky z akce <a n:href="Event:detail slug => $gallery->getEvent()->getSlug()">{$gallery->getEvent()->getTitle()}</a>
			</span>
		</p>

		<p n:if="!$gallery->getPhotos()">V galerii zatím nejsou žádné fotky.</p>

		<div class="row photo-grid">
			<div n:foreach="$gallery->getPhotos() as $photo" class="col-6 col-md-3 mb-4">
				<a href="{$basePath}{$photo->getFile()->getPath()}" class="glightbox" data-gallery="gallery-{$gallery->getId()}" data-description="{$photo->getDescription()}">
					<img src="{$basePath}{$photo->getFile()->getPath()}" alt="{$photo->getDescription() ?? $gallery->getTitle()}">
				</a>
			</div>
		</div>

		<p class="mt-3"><a n:href="default">&larr; Zpět na fotogalerie</a></p>
	</div>
</section>
