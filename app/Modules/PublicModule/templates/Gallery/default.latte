{block content}

<section class="section">
	<div class="container">
		<h1>Fotogalerie</h1>

		<p n:if="!$galleries">Zatím tu nejsou žádné galerie.</p>

		<div class="row">
			<div n:foreach="$galleries as $gallery" class="col-md-4 mb-4">
				<a n:href="detail slug => $gallery->getSlug()" class="gallery-card">
					<img n:if="$gallery->getMainImage()" class="gallery-thumb" src="{$basePath}{$gallery->getMainImage()->getPath()}" alt="{$gallery->getTitle()}">
					<h3>{$gallery->getTitle()}</h3>
					<p class="item-meta" n:if="$gallery->getDate()">{$gallery->getDate()|date:'j. n. Y'}</p>
				</a>
			</div>
		</div>
	</div>
</section>
