<!DOCTYPE html>
<html lang="cs">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="description" content="">
	<meta name="keywords" content="">
	<meta name="robots" content="noindex, nofollow">
	<meta name="author" content="">

	<link rel="apple-touch-icon" sizes="180x180" href="{$basePath}/images/favicons/apple-touch-icon.png">
	<link rel="icon" type="image/png" sizes="32x32" href="{$basePath}/images/favicons/favicon-32x32.png">
	<link rel="icon" type="image/png" sizes="16x16" href="{$basePath}/images/favicons/favicon-16x16.png">
	<link rel="manifest" href="{$basePath}/images/favicons/site.webmanifest">
	<link rel="mask-icon" href="{$basePath}/images/favicons/safari-pinned-tab.svg" color="#7c7c7c">
	<meta name="msapplication-TileColor" content="#603cba">
	<meta name="theme-color" content="#ffffff">
	<meta name="format-detection" content="telephone=no">

	<title>SK Alpin</title>

	<link rel="stylesheet" href="{$basePath}/dist/css/app.css">
	<link rel="stylesheet" href="{$basePath}/dist/css/admin.css">

	<link rel="stylesheet" href="https://cdn.ckeditor.com/ckeditor5/43.0.0/ckeditor5.css" />
	<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

	<script src="{$basePath}/dist/js/app.js?v={mt_rand(100,999)}"></script>

	<script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
</head>

<body>

	<main>
		{if $user->isLoggedIn()}
			<nav class="navbar navbar-expand navbar-dark bg-dark">
				<div class="container">
					<a class="navbar-brand" n:href="Homepage:default">SK-Alpin — administrace</a>
					<div class="navbar-nav me-auto">
						<a class="nav-link" n:href="Event:default">Akce</a>
						<a class="nav-link" n:href="News:default">Aktuality</a>
						<a class="nav-link" n:href="Gallery:default">Fotogalerie</a>
						<a class="nav-link" n:href="Page:default">Stránky</a>
						<a class="nav-link" n:href="ContactMessage:default">Zprávy</a>
						<a class="nav-link" n:href="Settings:default">Nastavení</a>
					</div>
					<div class="navbar-nav">
						<a class="nav-link" n:href="Sign:out">Odhlásit</a>
					</div>
				</div>
			</nav>
		{/if}

		<section class="container g-py-25">
			{snippet flashes}
				<div n:foreach="$flashes as $flash" n:class="alert, 'alert-' . $flash->type">{$flash->message}</div>
			{/snippet}

			{include content}
		</section>
	</main>

	{block scripts}
		{ifset componentJs}{include componentJs}{/ifset}
	{/block}

	<script src="{$basePath}/assets/js/nette.ajax.js"></script>

	{include 'include/js.latte'}

	{block js}{/block}
</body>
</html>
